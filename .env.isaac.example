# Isaac Sim's container requires explicit acceptance of NVIDIA's EULA.
ACCEPT_EULA=N
PRIVACY_CONSENT=N
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:6.2.0

# One worker uses one physical GPU. The wrapper sets WORKER_COUNT to 1 for
# `start` and 2 for `start-dual`; this value supports direct Compose use.
ISAAC_GPU_0=0
ISAAC_GPU_1=1
WORKER_COUNT=1
NUM_ENVS=4
EPISODES=300
DATASET_SEED=0
ISAAC_RENDERER=RaytracedLighting
ISAAC_MULTI_GPU_RENDERING=false
